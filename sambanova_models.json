      "rpm_limit": 20,
      "used_today": 0,
      "exhausted": false
    },
    "general_reasoning": {
      "id": "DeepSeek-V3",
      "task": "general_heavy_reasoning",
      "supports_inputs": ["text"],
      "rpd_limit": 500,
      "rpm_limit": 20,
      "used_today": 0,
      "exhausted": false
    },
    "flagship_chat": {
      "id": "Meta-Llama-3.3-70B-Instruct",
      "task": "core_dialogue_and_long_context",
      "supports_inputs": ["text"],
      "rpd_limit": 1000,
      "rpm_limit": 20,
      "used_today": 0,
      "exhausted": false
    },
    "fast_chat": {
      "id": "Meta-Llama-3.1-8B-Instruct",
      "task": "low_latency_quick_chat",
      "supports_inputs": ["text"],
      "rpd_limit": 2000,
      "rpm_limit": 20,
      "used_today": 0,
      "exhausted": false
    },
    "multilingual_ocr": {
      "id": "gemma-3-27b-it",
      "task": "multilingual_ocr_vision_extraction",
