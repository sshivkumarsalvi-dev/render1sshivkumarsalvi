{
  "provider": "sambanova",
  "endpoint": "https://api.sambanova.ai/v1/chat/completions",
  "env_key": "SAMBANOVA-API-OK",
  "limits": {
    "global_rpm": 20,
    "total_platform_daily_cap": 4200
  },
  "runtime_state": {
    "total_requests_today": 0,
    "current_minute_requests": 0,
    "last_minute_timestamp": 0.0,
    "is_revoked": false,
    "revoked_until": 0.0,
    "last_daily_reset": 0.0
  },
  "models": {
    "deep_reasoning": {
      "id": "DeepSeek-R1",
      "task": "math_logic_cot_deep_reasoning",
