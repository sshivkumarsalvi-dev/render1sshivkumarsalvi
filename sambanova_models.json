{
  "provider": "sambanova",
  "endpoint": "https://api.sambanova.ai/v1/chat/completions",
  "env_key": "SAMBANOVA-API-OK",
  "default_model": "Meta-Llama-3.1-70B-Instruct",
  "limits": {
    "rpm": 20,
    "rpd": 5000
  },
  "runtime_state": {
    "total_requests": 0,
    "current_minute_requests": 0,
    "last_minute_timestamp": 0.0,
    "is_rate_limited": false,
    "cooldown_until": 0.0
  }
}
